# Nādabrahma — CLI config (copy to .env)

# ── Required ──────────────────────────────────────────────────────────────────
# Groq free tier — no credit card. Get a key at https://console.groq.com
GROQ_API_KEY=gsk_...
# Model (default shown). Change only if you switch models.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional tuning (guardrails / volume) ─────────────────────────────────────
# Local gem cache (SQLite). Default: ~/.nadabrahma/gems.db
# DB_PATH=/root/.nadabrahma/gems.db

# Results per search query (we run 3 angles: studio, live, raga).
# MAX_CANDIDATES=10
# Candidates we metadata-screen for FREE to find hidden gems (no comments).
# META_DEPTH=9
# Of those, how many we fetch comments for + AI-score (the work-heavy step).
# COMMENT_DEPTH=4
# Comments pulled per video for AI emotion scoring.
# MAX_COMMENTS=30
# Ignore clips shorter than this many seconds (filters shorts/junk).
# MIN_DURATION_SECS=180
# Skip renditions above this many views. 0 = off. The `deep` command sets 150000.
# MAX_VIEWS=0

#  yt-dlp does all YouTube work and is free (no per-video cost, no card).
# The YouTube Data API is NOT used. Only Groq tokens are consumed (per-kriti, free tier).
